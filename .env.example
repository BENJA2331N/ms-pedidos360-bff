# =======================================================
# Variables de Entorno - ms-pedidos360-bff
# Copia este archivo como .env para configuraciones locales
# =======================================================

# Puerto del BFF
SERVER_PORT=8080

# Azure Entra ID (Configuración de Tenant y App Registration)
AZURE_TENANT_ID=<TENANT_ID>
AZURE_CLIENT_ID=<API_CLIENT_ID>

# Issuer URI para validar firma y vigencia del JWT
JWT_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0

# Audience para validar que el token fue emitido específicamente para este BFF
JWT_AUDIENCE=api://<API_CLIENT_ID>

# URLs de los microservicios downstream
ORDERS_SERVICE_URL=http://localhost:8082
CATALOG_SERVICE_URL=http://localhost:8081
